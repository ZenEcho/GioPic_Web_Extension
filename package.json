{
  "displayName": "GioPic",
  "name": "giopic",
  "version": "2.2.1",
  "author": "TraeAI",
  "description": "GioPic Web Extension,图片上传扩展程序提供lsky,EasyImages,chevereto,阿里云oss,AWS S3,等程序的上传",
  "private": true,
  "main": "dist-electron/main.js",
  "type": "module",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "build": {
    "appId": "com.giopic.desktop",
    "productName": "GioPic",
    "directories": {
      "output": "dist"
    },
    "win": {
      "icon": "public/assets/icons/logo256.png",
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "linux": {
      "icon": "public/assets/icons/logo256.png"
    },
    "mac": {
      "icon": "public/assets/icons/logo256.png"
    }
  },
  "scripts": {
    "dev": "cross-env ELECTRON=true vite",
    "build": "cross-env ELECTRON=true vite build && electron-builder",
    "build:check": "vue-tsc --build",
    "preview": "vite preview",
    "test": " esno test/test.ts",
    "clear": "rimraf --glob dist"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.966.0",
    "@aws-sdk/lib-storage": "3.966.0",
    "ali-oss": "6.23.0",
    "axios": "1.13.2",
    "canvas-confetti": "1.9.4",
    "cos-js-sdk-v5": "1.10.1",
    "idb": "8.0.3",
    "naive-ui": "2.43.2",
    "pinia": "3.0.4",
    "util": "0.12.5",
    "uuid": "13.0.0",
    "vfonts": "0.0.3",
    "vue": "3.5.26",
    "vue-i18n": "11.2.8",
    "vue-router": "4.6.4"
  },
  "devDependencies": {
    "@iconify-json/ph": "1.2.2",
    "@tsconfig/node24": "24.0.3",
    "@types/ali-oss": "6.23.0",
    "@types/canvas-confetti": "1.9.0",
    "@types/node": "24.10.4",
    "@types/webextension-polyfill": "0.12.4",
    "@unocss/preset-icons": "66.5.12",
    "@unocss/preset-rem-to-px": "66.6.0",
    "@vitejs/plugin-vue": "6.0.3",
    "@vue/test-utils": "2.4.6",
    "@vue/tsconfig": "0.8.1",
    "cross-env": "7.0.3",
    "electron": "40.0.0",
    "electron-builder": "26.4.0",
    "esno": "4.8.0",
    "npm-run-all2": "8.0.4",
    "typescript": "5.9.3",
    "unocss": "66.5.12",
    "unplugin-auto-import": "20.3.0",
    "unplugin-vue-components": "30.0.0",
    "vite": "7.3.1",
    "vite-plugin-electron": "0.29.0",
    "vite-plugin-electron-renderer": "0.14.6",
    "vite-plugin-node-polyfills": "0.25.0",
    "vite-plugin-vue-devtools": "8.0.5",
    "vitest": "4.0.16",
    "vue-tsc": "3.2.2",
    "webextension-polyfill": "0.12.0"
  }
}
