{
  "displayName": "GioPic - 图片上传",
  "name": "giopic",
  "version": "2.3.2",
  "description": "GioPic Web Extension,图片上传扩展程序提供lsky,EasyImages,chevereto,阿里云oss,AWS S3,等程序的上传",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev": "cross-env NODE_ENV=development npm-run-all clear prepare --parallel dev:main dev:bg dev:content dev:page",
    "dev:firefox": "cross-env NODE_ENV=development EXTENSION=firefox npm-run-all clear prepare --parallel dev:main dev:bg dev:content dev:page",
    "dev:main": "vite",
    "dev:bg": "cross-env NODE_ENV=development TARGET=background vite build --watch",
    "dev:content": "cross-env NODE_ENV=development TARGET=content vite build --watch",
    "dev:page": "cross-env NODE_ENV=development TARGET=page vite build --watch",
    "build": "cross-env NODE_ENV=production npm-run-all clear prepare --parallel build:web build:ext build:check",
    "build:firefox": "cross-env NODE_ENV=production EXTENSION=firefox npm-run-all clear prepare --parallel build:web build:ext build:check",
    "build:web": "vite build",
    "build:ext": "cross-env TARGET=background vite build && cross-env TARGET=content vite build && cross-env TARGET=page vite build",
    "build:check": "vue-tsc --build",
    "preview": "vite preview",
    "prepare": "esno manifest/prepare.ts",
    "test": " esno test/test.ts",
    "clear": "rimraf --glob dist"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.980.0",
    "@aws-sdk/lib-storage": "^3.980.0",
    "@types/canvas-confetti": "^1.9.0",
    "@types/fs-extra": "^11.0.4",
    "ali-oss": "^6.23.0",
    "axios": "^1.13.4",
    "canvas-confetti": "^1.9.4",
    "cos-js-sdk-v5": "^1.10.1",
    "idb": "^8.0.3",
    "naive-ui": "^2.43.2",
    "pinia": "^3.0.4",
    "util": "^0.12.5",
    "uuid": "^13.0.0",
    "vfonts": "^0.0.3",
    "vue": "^3.5.27",
    "vue-i18n": "^11.2.8",
    "vue-router": "^4.6.4",
    "webextension-polyfill": "^0.12.0"
  },
  "devDependencies": {
    "@iconify-json/ph": "^1.2.2",
    "@tsconfig/node24": "^24.0.4",
    "@types/ali-oss": "^6.23.2",
    "@types/chrome": "^0.1.36",
    "@types/node": "^24.10.9",
    "@types/webextension-polyfill": "^0.12.4",
    "@unocss/preset-icons": "^66.6.0",
    "@unocss/preset-rem-to-px": "^66.6.0",
    "@vitejs/plugin-vue": "^6.0.3",
    "@vue/test-utils": "^2.4.6",
    "@vue/tsconfig": "^0.8.1",
    "chokidar": "^4.0.3",
    "cross-env": "^7.0.3",
    "esno": "^4.8.0",
    "fs-extra": "^11.3.3",
    "npm-run-all2": "^8.0.4",
    "rimraf": "^6.1.2",
    "typescript": "~5.9.3",
    "unocss": "^66.6.0",
    "unplugin-auto-import": "^20.3.0",
    "unplugin-vue-components": "^30.0.0",
    "vite": "^7.3.1",
    "vite-plugin-vue-devtools": "^8.0.5",
    "vitest": "^4.0.18",
    "vue-tsc": "^3.2.4"
  }
}
